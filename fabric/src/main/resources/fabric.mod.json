{
  "schemaVersion": 1,
  "id": "catcraft_moderation_companion",
  "version": "${version}",
  "name": "CatCraft Companion",
  "description": "Client-side command navigation, player profiles, staff utilities, and conflict-aware chat enhancements for CatCraft players.",
  "authors": [
    {
      "name": "B0_Deadly"
    }
  ],
  "contact": {
    "homepage": "https://www.catcraft.net/",
    "issues": "https://wiki.catcraft.net/?ref=catcraft.net"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.catcraft.ccmc.CcmcCore",
      "net.catcraft.ccmc.CatCraftModerationCompanion"
    ],
    "modmenu": [
      "net.catcraft.ccmc.integration.CcmcModMenuIntegration"
    ]
  },
  "mixins": [
    "ccmc-core.mixins.json",
    "ccmc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "cloth-config": ">=26.3.158"
  },
  "suggests": {
    "modmenu": "*"
  }
}
